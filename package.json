{
  "name": "canal-dark",
  "version": "0.0.0",
  "main": "electron/main.mjs",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host 0.0.0.0 --port 3000",
    "start": "node dist/canal-dark/server/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "cli": "node scripts/render-cli.mjs",
    "render": "node scripts/render-cli.mjs render",
    "listar": "node scripts/render-cli.mjs list",
    "app": "node scripts/app-launcher.mjs",
    "app:dev": "set CANAL_DARK_DEV_URL=http://localhost:3000&& node scripts/app-launcher.mjs",
    "app:smoke": "node scripts/app-launcher.mjs --smoke",
    "portatil": "npm run build && node scripts/preparar-portatil.mjs && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.canaldark.studio",
    "productName": "Canal Dark",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "build/portable/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "kokoro-v1.0.onnx",
        "to": "kokoro-v1.0.onnx"
      },
      {
        "from": "voices-v1.0.bin",
        "to": "voices-v1.0.bin"
      },
      {
        "from": "voz_canal.npy",
        "to": "voz_canal.npy"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Canal-Dark-Portatil-${version}.exe"
    },
    "portable": {
      "artifactName": "Canal-Dark-Portatil-${version}.exe",
      "unicode": true
    }
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@google/genai": "^3.6.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "msedge-tts": "^2.1.1",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
