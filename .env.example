# Chave da API Gemini (uso exclusivo no servidor, faixa gratuita)
GEMINI_API_KEY=

# Modelo usado para roteiro e URL Context (opcional; padrao: gemini-flash-lite-latest)
# Para listar os modelos que sua chave acessa:
#   node -e "fetch('https://generativelanguage.googleapis.com/v1beta/models?key='+process.env.GEMINI_API_KEY)"
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Narracao (Gemini TTS usa a mesma GEMINI_API_KEY, faixa gratuita)
# ---------------------------------------------------------------------------
# Motor padrao: gemini (recomendado) | edge (voz reserva, sem chave)
TTS_ENGINE=kokoro
# Modelo de fala; 2.5-flash-preview-tts e o que respondeu mais rapido aqui
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Voz padrao: Kore | Charon | Puck | Aoede | Fenrir
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE=pt-BR
# 1 = usa instrucao de estilo no prompt (ancora, explicativo, urgente, leve).
# Coloque 0 se a instrucao comecar a ser lida em voz alta.
TTS_STYLE_INSTRUCTIONS=1
# Em falha/cota do Gemini, cai para o Edge em vez de deixar a cena muda (1 = sim)
TTS_FALLBACK_EDGE=1

# ---------------------------------------------------------------------------
# Publicacao no YouTube (Google Cloud > APIs > YouTube Data API v3 > Credenciais)
# ---------------------------------------------------------------------------
# Tipo "OAuth client ID" para aplicativo desktop/Web com redirect:
#   http://127.0.0.1:3000/api/youtube/auth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/auth/callback

# Privacidade padrao do envio: unlisted (seguro) | public | private
YOUTUBE_PRIVACY_DEFAULT=unlisted

# 1 = pedir tambem o escopo de receita estimada (yt-analytics-monetary.readonly)
YOUTUBE_MONETARY_SCOPE=0

# Onde fica o refresh token obtido pelo botao "Conectar YouTube" (fora do git)
CANAL_DARK_YOUTUBE_TOKEN=

# ---------------------------------------------------------------------------
# TikTok (Content Posting API) â€” so funciona com app AUDITADO pela TikTok
# ---------------------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
# 1 somente depois de aprovado no audit; sem isso todo post sairia privado
TIKTOK_AUDITED=0

# ---------------------------------------------------------------------------
# Instagram Reels (Meta Graph / Content Publishing)
# ---------------------------------------------------------------------------
IG_USER_ID=
FB_ACCESS_TOKEN=
# O Instagram baixa o video de uma URL publica: informe a base publica deste servidor
CANAL_DARK_PUBLIC_BASE_URL=

# Tarja de identidade impressa no topo do video final
CHANNEL_LABEL=NOTÃCIAS NA BRASA Â· APRESENTADOR VIRTUAL
